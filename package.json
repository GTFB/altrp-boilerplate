{
  "name": "altrp-boilerplate",
  "version": "1.0.0",
  "description": "The Altrp Digital Asset Factory",
  "private": true,
  "packageManager": "bun@1.0.0",
  "scripts": {
    "build": "bun run --cwd apps/payload build",
    "dev": "bun run --cwd apps/payload dev",
    "lint": "bun run --cwd apps/payload lint",
    "test": "bun run --cwd apps/payload test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "setup": "cd scripts && bash setup.sh -d altrp.localhost",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "dev:payload": "bun install && bun run --cwd apps/payload dev",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:payload": "playwright test tests/e2e/payload/",
    "test:e2e:quick": "bunx playwright test tests/e2e/quick.spec.ts --project=payload-chromium --reporter=list",
    "test:e2e:report": "playwright show-report",
    "test:int:collections": "bun run --cwd apps/payload test:int",
    "test:unit": "bun run --cwd apps/payload test:unit"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.2.5",
    "vitest": "3.2.3"
  },
  "author": "Altrp.io",
  "license": "MIT",
  "dependencies": {
    "-": "^0.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "lucide-react": "^0.537.0",
    "payload": "3.50.0"
  }
}
